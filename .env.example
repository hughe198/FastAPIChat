# Copy to .env (not committed) for local development, or set these as
# real environment variables on the server.

# Admin endpoints (/api/admin/*) return 404 until this is set.
ADMIN_PASSWORD=

# Signs admin login tokens. Use a long random string, e.g. the output of:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If unset, a random one is generated at start-up (admins re-login after restarts).
ADMIN_SECRET=

# How long an admin login lasts.
ADMIN_TOKEN_HOURS=8

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=*
